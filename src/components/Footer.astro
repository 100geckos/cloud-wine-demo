---
import Brand from './Brand.astro';
import { business, brand, navigation } from '../lib/content';
---

<footer class="site-footer">
  <div class="shell footer-top">
    <div>
      <Brand />
      <p>
        A little wine. A little conversation.
        <br />A little more time together.
      </p>
    </div>
    <div>
      <span class="eyebrow">Find your way</span>
      <ul>
        {navigation.slice(1).map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <span class="eyebrow">In the neighborhood</span>
      <p>
        {business.address.street}
        <br />
        {business.address.city}, {business.address.region}
      </p>
      {business.socials.map((social) => (
        <a
          class="text-link"
          href={social.url}
          target="_blank"
          rel="noopener noreferrer"
        >
          {social.name} <span aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </div>
  <div class="shell footer-bottom">
    <p>
      Independent concept by {brand.agency}. No affiliation with or endorsement
      by {business.name}.
    </p>
    <a href="/preview-notes/">Sources & photo credits</a>
  </div>
</footer>
