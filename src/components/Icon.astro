---
interface Props {
  name?: 'arrow' | 'pin' | 'glass' | 'star' | 'close' | 'phone';
  class?: string;
}
const { name = 'arrow', class: className = '' } = Astro.props;
const paths = {
  arrow: 'M4 12h15m-6-6 6 6-6 6',
  pin: 'M20 10c0 6-8 11-8 11S4 16 4 10a8 8 0 1 1 16 0ZM15 10a3 3 0 1 1-6 0 3 3 0 0 1 6 0',
  glass: 'M7 3h10l1 6a6 6 0 0 1-12 0l1-6ZM6 8h12M12 15v6m-4 0h8',
  star: 'M12 2v20M2 12h20M5 5l14 14M5 19 19 5',
  close: 'm5 5 14 14M5 19 19 5',
  phone: 'M5 3h4l2 5-3 2a15 15 0 0 0 6 6l2-3 5 2v4c-8 4-20-8-16-16Z',
};
---

<svg
  class={className}
  width="22"
  height="22"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.3"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={paths[name]} />
</svg>
