---
import type { MenuCategory } from '../lib/schemas';
import Icon from './Icon.astro';
const { category } = Astro.props as { category: MenuCategory };
const verifiedItems = category.items.filter((item) => item.verified);
---

<section
  class="menu-section"
  id={category.id}
  data-menu-category
  aria-labelledby={`${category.id}-title`}
>
  <div>
    <p class="eyebrow">{category.eyebrow}</p>
    <h2 id={`${category.id}-title`}>{category.name}</h2>
    <p>{category.description}</p>
  </div>
  {verifiedItems.length ? (
    <ul class="menu-items">
      {verifiedItems.map((item) => (
        <li>
          <div>
            <h3>{item.name}</h3>
            {item.description && <p>{item.description}</p>}
          </div>
          {item.price != null && (
            <span>
              {new Intl.NumberFormat('en-US', {
                style: 'currency',
                currency: 'USD',
              }).format(item.price)}
            </span>
          )}
        </li>
      ))}
    </ul>
  ) : (
    <div class="menu-empty">
      <Icon name="glass" />
      <h3>{category.emptyMessage}</h3>
      <p>No unconfirmed items or prices are shown in this preview.</p>
      <a class="text-link" href="/contact/">
        Ask about today’s selection <Icon />
      </a>
    </div>
  )}
</section>
