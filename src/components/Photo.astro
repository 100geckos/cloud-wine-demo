---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { brand } from '../lib/content';
interface Props {
  id: string;
  class?: string;
  priority?: boolean;
  sizes?: string;
}
const {
  id,
  class: className = '',
  priority = false,
  sizes = '(min-width: 960px) 50vw, 100vw',
} = Astro.props;
const photos = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/*.{jpg,png,webp}',
  { eager: true },
);
const entry = brand.images.find((i) => i.id === id);
if (!entry) throw new Error(`Unknown image: ${id}`);
const filename = entry.file.split('/').at(-1);
const photo = photos[`../assets/${filename}`]?.default;
if (!photo) throw new Error(`Missing local image: ${entry.file}`);
---

<Image
  src={photo}
  alt={entry.alt}
  class={className}
  widths={[480, 800, 1200, 1800]}
  sizes={sizes}
  format="webp"
  quality={78}
  loading={priority ? 'eager' : 'lazy'}
  decoding="async"
  fetchpriority={priority ? 'high' : 'auto'}
/>
