<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta
      name="description"
      content="Local content editor for the Cloud Wine design concept."
    />
    <title>Cloud Wine content editor · Piedmont Digital</title>
    <style is:global>
      body {
        margin: 0;
        background: #f6f2e9;
        color: #282a26;
        font:
          16px/1.6 system-ui,
          sans-serif;
      }
      .notice {
        max-width: 42rem;
        margin: 12vh auto;
        padding: 2rem;
      }
      h1 {
        color: #581f31;
        font:
          2.7rem/1.1 Georgia,
          serif;
      }
      a {
        color: #581f31;
      }
      code {
        background: #eee6d9;
        padding: 0.15rem 0.35rem;
        border-radius: 0.25rem;
      }
    </style>
  </head>
  <body>
    <main class="notice" id="status">
      <h1>Cloud Wine content editor</h1>
      <p id="message">Loading the local editor…</p>
      <p>
        <a href="/">Return to the website</a>
      </p>
    </main>
    <script is:inline>
      const local = ['localhost', '127.0.0.1'].includes(location.hostname);
      const message = document.querySelector('#message');
      if (!local) {
        message.textContent =
          'The hosted editor is awaiting a scoped GitHub sign-in service. Edit locally for now; see the editor guide in the repository.';
      } else {
        const script = document.createElement('script');
        script.src =
          'https://cdn.jsdelivr.net/npm/decap-cms@3.17.3/dist/decap-cms.js';
        script.onload = () => document.querySelector('#status')?.remove();
        script.onerror = () => {
          message.innerHTML =
            'The editor bundle could not load. Check your internet connection, then refresh. Start the local writing service with <code>npm run editor:proxy</code>.';
        };
        document.body.append(script);
      }
    </script>
  </body>
</html>
